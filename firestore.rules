rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to get the role of the user in a client
    function getClientRole(clientId) {
      return get(/databases/$(database)/documents/clients/$(clientId)).data.members[request.auth.uid];
    }

    // Users Collection
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Clients Collection
    match /clients/{clientId} {
      allow read: if isAuthenticated() && (
        resource.data.members[request.auth.uid] != null || 
        resource.data.createdBy == request.auth.uid
      );
      allow create: if isAuthenticated() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.members[request.auth.uid] == 'owner' || 
        resource.data.members[request.auth.uid] == 'admin'
      );
      allow delete: if isAuthenticated() && resource.data.members[request.auth.uid] == 'owner';
    }

    // GA4 Connections
    match /ga4_properties/{propId} {
      allow read: if isAuthenticated() && (
        resource == null || 
        getClientRole(resource.data.clientId) != null
      );
      allow create, update: if isAuthenticated() && (
        getClientRole(request.resource.data.clientId) == 'owner' || 
        getClientRole(request.resource.data.clientId) == 'admin'
      );
      allow delete: if isAuthenticated() && (
        getClientRole(resource.data.clientId) == 'owner' || 
        getClientRole(resource.data.clientId) == 'admin'
      );
    }

    // GTM Connections
    match /gtm_containers/{containerId} {
      allow read: if isAuthenticated() && (
        resource == null || 
        getClientRole(resource.data.clientId) != null
      );
      allow create, update: if isAuthenticated() && (
        getClientRole(request.resource.data.clientId) == 'owner' || 
        getClientRole(request.resource.data.clientId) == 'admin'
      );
      allow delete: if isAuthenticated() && (
        getClientRole(resource.data.clientId) == 'owner' || 
        getClientRole(resource.data.clientId) == 'admin'
      );
    }

    // Google Credentials - Server-side only
    match /google_credentials/{credId} {
      allow read, write: if false;
    }

    // Audit Runs
    match /audit_runs/{auditId} {
      allow read: if isAuthenticated() && (
        resource == null || 
        getClientRole(resource.data.clientId) != null
      );
      allow create, update: if isAuthenticated() && (
        getClientRole(request.resource.data.clientId) == 'owner' || 
        getClientRole(request.resource.data.clientId) == 'admin'
      );
      allow delete: if isAuthenticated() && (
        getClientRole(resource.data.clientId) == 'owner' || 
        getClientRole(resource.data.clientId) == 'admin'
      );
    }

    // Implementation Agent server-authored records
    match /implementation_requests/{requestId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        getClientRole(resource.data.clientId) != null
      );
      allow write: if false;
    }

    match /implementation_plans/{planId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        getClientRole(resource.data.clientId) != null
      );
      allow write: if false;
    }

    match /gtm_change_logs/{logId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /vendor_docs/{docId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        getClientRole(resource.data.clientId) != null
      );
      allow write: if false;
    }
  }
}
